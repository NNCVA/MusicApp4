<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!--
    fillColor 设置为透明 (#00000000)
    strokeColor 设置为图片中的蓝色 (#5C85C5)
    strokeWidth 设置线条宽度为 2
    strokeLineCap/Join 设置为圆角，使箭头看起来更平滑
  -->
